FROM python:3.11.10-slim
WORKDIR /opt/my-predictor
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements-paper-cpu.txt ./
RUN pip install --no-cache-dir -r requirements-paper-cpu.txt
COPY my_predictor ./my_predictor
COPY configs ./configs
COPY docs ./docs
COPY scripts ./scripts
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --no-deps .
ENTRYPOINT ["disorder-paper"]
CMD ["--help"]
